# === Claude Code (default backend) ===
CLAUDE_CODE_OAUTH_TOKEN=         # from `claude setup-token`
CLAUDE_BACKEND=claude-code       # "claude-code" (default) or "api"
CLAUDE_CODE_MODEL=sonnet         # model for Claude Code CLI
CLAUDE_BIN=claude                # path override for Claude Code binary

# === Anthropic API (optional backend) ===
ANTHROPIC_API_KEY=               # required only when CLAUDE_BACKEND=api
CLAUDE_MODEL=claude-sonnet-4-20250514

# === Freesound ===
FREESOUND_API_KEY=               # https://freesound.org/apiv2/apply/

# === Instagram Graph API ===
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_HOST=graph.facebook.com
GRAPH_API_VERSION=v23.0
UPLOAD_MODE=resumable            # "resumable" or "url"

# === S3/R2 (only for UPLOAD_MODE=url) ===
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=                   # public base URL for the bucket

# === Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=               # Slack/Discord/n8n incoming webhook
NOTIFY_ON_SUCCESS=true           # set false to alert only on errors
