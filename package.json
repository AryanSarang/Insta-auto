{
  "name": "reels-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated Instagram Reels bot — physics merge-evolution simulations",
  "main": "src/run.js",
  "bin": {
    "reels-bot": "src/run.js"
  },
  "scripts": {
    "start": "node src/run.js",
    "dry-run": "node src/run.js --dry-run",
    "fill-queue": "node src/run.js --fill-queue=2",
    "setup-assets": "node scripts/setup-assets.js",
    "chat-prompt": "node scripts/chat-prompt.js",
    "test": "node --test tests/test-engine.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.44.0",
    "unicode-emoji-json": "^0.6.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.600.0"
  }
}
